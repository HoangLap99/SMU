Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "id": "{{kiemKeKhoId}}",
  "maPhieuKiemKe": "KK-2026-10-10-921",
  "ngayKiemKe": "2026-10-10T00:00:00Z",
  "thoiGianKiemKe": "17 giờ 15 phút",
  "loaiPhuongTien": "Ô tô",
  "tongTonHeThong": 299,
  "tongThucTe": 299,
  "tongChenhLech": 0,
  "trangThai": "HoanTat",
  "xacNhanHoanTat": true,
  "ghiChu": "Xác nhận chốt số liệu kiểm kê kho",
  "danhSachNhomDauBien": [
    {
      "stt": 1,
      "dauBien": "29E-794",
      "mauBien": "Biển Vàng",
      "tonHeThong": 39,
      "thucTe": 40,
      "chenhLech": 1,
      "ghiChu": "Thừa 1 biển",
      "danhSachBienTrongKho": [
        {
          "bienKiemSoat": "29E-794.01",
          "trangThaiKiemKe": "CoMat",
          "isCoMat": true,
          "ghiChu": "Có mặt"
        }
      ],
      "danhSachBienThua": [
        {
          "bienKiemSoat": "29E-794.02",
          "ghiChu": "Phát hiện thừa thực tế (tự xác định dải 29E-794 khi xác nhận hoàn tất -> Nhập vào KhoBienSo)"
        }
      ]
    }
  ]
}

### Lưu Id phiếu kiểm kê vừa tạo
@kiemKeKhoId = {{setKiemKeKho.response.body.id}}

### 4. (POST) LẤY DANH SÁCH PHIẾU KIỂM KÊ CÓ PHÂN TRANG VÀ BỘ LỌC
POST {{SMU_HostAddress}}/api/KiemKeKho/danhsach
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "currentPage": 1,
  "pageSize": 10,
  "keyWord": "KK-2026",
  "loaiPhuongTien": "Ô tô",
  "trangThai": null
}

### 5. (GET) LẤY CHI TIẾT 1 PHIẾU KIỂM KÊ THEO ID
GET {{SMU_HostAddress}}/api/KiemKeKho/{{kiemKeKhoId}}
Authorization: Bearer {{authToken}}
Accept: application/json

### 6. (GET) XÓA PHIẾU KIỂM KÊ THEO ID
GET {{SMU_HostAddress}}/api/KiemKeKho/delete/{{kiemKeKhoId}}
Authorization: Bearer {{authToken}}


